# backend deepface service's endpoint, do not change if not necessary
REACT_APP_SERVICE_ENDPOINT=http://localhost:5005

# Set facial recognition model: VGG-Face, Facenet, Facenet512, OpenFace, DeepFace, DeepId, ArcFace, Dlib, SFace, GhostFaceNet
REACT_APP_FACE_RECOGNITION_MODEL=Facenet

# Set face detector: opencv, ssd, mtcnn, dlib, mediapipe, retinaface, yolov8, yunet, centerface
REACT_APP_DETECTOR_BACKEND=opencv

# Set distance metric: cosine, euclidean, euclidean_l2
REACT_APP_DISTANCE_METRIC=cosine

# Set REACT_APP_ANTI_SPOOFING to 1 if you want to enable anti-spoofing
REACT_APP_ANTI_SPOOFING=0

# Optional: bearer token if DEEPFACE_AUTH_TOKEN is set on the API
# REACT_APP_AUTH_TOKEN=your_token

# Auto-verify interval in ms (0 to disable). Failed verifications save screenshots automatically.
REACT_APP_AUTO_VERIFY_INTERVAL_MS=3000

# Max unverified screenshots per browser session run is enforced server-side (default 20).
# DEEPFACE_UNVERIFIED_LIMIT_PER_RUN=20

# Hebrew voice API (hebrewscribe-voice-api sibling repo)
REACT_APP_VOICE_SERVICE_ENDPOINT=http://localhost:5006
REACT_APP_VOICE_LANGUAGE=he
# REACT_APP_VOICE_AUTH_TOKEN=your_token

# Faces are stored in Postgres via the DeepFace API (/register, /search).
# Local setup (no Docker): scripts/setup-local.ps1 then scripts/start-local.ps1